<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DynoCommandPC</RootNamespace>
    <AssemblyName>DynoCommandPC</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>CommandModule.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so windows can use it as their runtime Icon (taskbar/title bar). -->
    <Resource Include="CommandModule.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dyno Dynamics DynoServer client library (net48; loads cleanly under .NET 8 — it's pure
         sockets/threads). Reused verbatim like the feeder does, to speak the DynoServer network
         as the handheld (DynoServerTransport). -->
    <Reference Include="DynoDotNet">
      <HintPath>libs\DynoDotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
