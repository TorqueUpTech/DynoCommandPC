<Window x:Class="DynoCommandPC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:proto="clr-namespace:DynoCommandPC.Protocol"
        Title="Settings" Width="460" Height="700" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Icon="CommandModule.ico"
        Background="#15181C" Foreground="#E8EBEE" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ObjectDataProvider x:Key="SpeedUnitValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="proto:SpeedUnit"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="SpeedControlValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="proto:SpeedControl"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1013"/>
            <Setter Property="Foreground" Value="#E8EBEE"/>
            <Setter Property="BorderBrush" Value="#3C4450"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="4,3"/></Style>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7FB2E5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA4B0"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <TextBlock Text="CONNECTION" Style="{StaticResource Hdr}" Margin="0,0,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="EDM address" Style="{StaticResource Lbl}" Grid.Column="0"/>
            <TextBox Grid.Column="1" Text="{Binding EdmBluetoothAddress, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Bluetooth MAC (0012F304962C) — or IP:port for TCP (127.0.0.1:51730) — or 'ds' / 'ds:&lt;ip&gt;' for the DynoServer network"/>
        </Grid>
        <TextBlock Text="MAC = direct Bluetooth (no pairing). IP:port = TCP to a simulator. 'ds' (or 'ds:&lt;server-ip&gt;') = join the DynoServer network as the handheld, same as the CAN feeder."
                   Style="{StaticResource Lbl}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/>
        <CheckBox Content="Auto-connect to the EDM at startup" IsChecked="{Binding AutoConnectAtStartup}" Margin="0,8,0,0"/>
        <CheckBox Content="Log comms to a timestamped file (logs\ beside the app)" IsChecked="{Binding LogCommsToFile}"/>

        <TextBlock Text="DYNO TYPE" Style="{StaticResource Hdr}"/>
        <CheckBox Content="4WD bed (send balance packet)" IsChecked="{Binding Is4Wd}"/>

        <TextBlock Text="SPEED" Style="{StaticResource Hdr}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Units" Style="{StaticResource Lbl}" Grid.Row="0"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Source={StaticResource SpeedUnitValues}}" SelectedItem="{Binding SpeedUnits}"/>
            <TextBlock Text="Speed control" Style="{StaticResource Lbl}" Grid.Row="1"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Source={StaticResource SpeedControlValues}}" SelectedItem="{Binding SpeedControl}"/>
            <TextBlock Text="Roller diameter (m)" Style="{StaticResource Lbl}" Grid.Row="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RollerDiameter}"/>
            <TextBlock Text="Gear ratio" Style="{StaticResource Lbl}" Grid.Row="3"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GearRatio}"/>
            <TextBlock Text="Max speed (km/h)" Style="{StaticResource Lbl}" Grid.Row="4"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SpeedMaxKph}"/>
            <TextBlock Text="Max speed (mph)" Style="{StaticResource Lbl}" Grid.Row="5"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SpeedMaxMph}"/>
            <TextBlock Text="Max speed (rpm)" Style="{StaticResource Lbl}" Grid.Row="6"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SpeedMaxRpm}"/>
            <TextBlock Text="Increment km/h (sm / lg)" Style="{StaticResource Lbl}" Grid.Row="7"
                       ToolTip="Nudge steps used when commanding road speed in km/h"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="70" Text="{Binding SpeedIncSmallKph}"/>
                <TextBox Width="70" Margin="6,2,0,2" Text="{Binding SpeedIncLargeKph}"/>
            </StackPanel>
            <TextBlock Text="Increment mph (sm / lg)" Style="{StaticResource Lbl}" Grid.Row="8"
                       ToolTip="Nudge steps used when commanding road speed in mph"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="70" Text="{Binding SpeedIncSmallMph}"/>
                <TextBox Width="70" Margin="6,2,0,2" Text="{Binding SpeedIncLargeMph}"/>
            </StackPanel>
            <TextBlock Text="Increment rpm (sm / lg)" Style="{StaticResource Lbl}" Grid.Row="9"
                       ToolTip="Nudge steps used in engine/rpm mode (rpm units or Engine control)"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="70" Text="{Binding SpeedIncSmallRpm}"/>
                <TextBox Width="70" Margin="6,2,0,2" Text="{Binding SpeedIncLargeRpm}"/>
            </StackPanel>
            <TextBlock Text="Start speed" Style="{StaticResource Lbl}" Grid.Row="10"
                       ToolTip="Run start speed, in the active speed unit"/>
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding StartSpeed}"/>
        </Grid>

        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource Hdr}"/>
        <CheckBox Content="Show packet log panel" IsChecked="{Binding ShowPacketLog}"/>
        <CheckBox Content="Show 'packet types seen' panel" IsChecked="{Binding ShowPacketsSeen}"/>
        <CheckBox Content="Show raw RX hex (pre-framing) + capture to logs\dyno-raw-*.log" IsChecked="{Binding ShowRawRx}"/>
        <CheckBox Content="Audible feedback (beep on actions)" IsChecked="{Binding AudibleFeedback}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Click="OnSave" MinWidth="80" Padding="10,6" Margin="3"
                    Background="#2A5A2A" Foreground="White"/>
            <Button Content="Cancel" Click="OnCancel" MinWidth="80" Padding="10,6" Margin="3"
                    Background="#2A3038" Foreground="White"/>
        </StackPanel>
        <TextBlock x:Name="txtPath" Style="{StaticResource Lbl}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    </ScrollViewer>
</Window>
